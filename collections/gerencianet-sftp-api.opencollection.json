{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account SFTP API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "SFTP",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate SFTP Key Pair",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/extrato-cnab/gerar-chaves"
          },
          "docs": "Generate SFTP Key Pair"
        }
      ]
    }
  ],
  "bundled": true
}