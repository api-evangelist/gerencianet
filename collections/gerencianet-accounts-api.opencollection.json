{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Simplified Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/conta-simplificada"
          },
          "docs": "Create Simplified Account"
        },
        {
          "info": {
            "name": "Generate Account Certificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/conta-simplificada/:identificador/certificado",
            "params": [
              {
                "name": "identificador",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Generate Account Certificate"
        },
        {
          "info": {
            "name": "Get Account Credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/conta-simplificada/:identificador/credenciais",
            "params": [
              {
                "name": "identificador",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Account Credentials"
        }
      ]
    }
  ],
  "bundled": true
}