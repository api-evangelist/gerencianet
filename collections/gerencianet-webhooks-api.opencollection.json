{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
