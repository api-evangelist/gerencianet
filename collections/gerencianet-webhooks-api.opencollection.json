            "name": "Detail Account Webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/webhook/:identificadorWebhook",
            "params": [
              {
                "name": "identificadorWebhook",
                "value": "",
                "type": "path"
              }
            ]
          },
