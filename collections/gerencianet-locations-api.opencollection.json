{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Locations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Pix Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/loc"
          },
          "docs": "List Pix Locations"
        },
        {
          "info": {
            "name": "Create Pix Location",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/loc"
          },
          "docs": "Create Pix Location"
        },
        {
          "info": {
            "name": "Detail Pix Location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/loc/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Detail Pix Location"
        },
        {
          "info": {
            "name": "Unlink Txid From Location",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/loc/:id/txid",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Unlink Txid From Location"
        }
      ]
    }
  ],
  "bundled": true
}