{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Reports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Reconciliation Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/gn/relatorios/extrato-conciliacao"
          },
          "docs": "Create Reconciliation Report"
        },
        {
          "info": {
            "name": "Detail Reconciliation Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/v2/gn/relatorios/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Detail Reconciliation Report"
        }
      ]
    }
  ],
  "bundled": true
}