{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Authorization API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/authorize",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange client_id and client_secret (HTTP Basic) for an OAuth2 access token used to authenticate subsequent Cobranças API calls."
        },
        {
          "info": {
            "name": "Issue Contas Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cobrancas.api.efipay.com.br/v1/oauth/token"
          },
          "docs": "Issue Contas Access Token"
        }
      ]
    }
  ],
  "bundled": true
}