            "url": "https://cobrancas.api.efipay.com.br/v1/carnet"
          },
          "docs": "Create Carnet"
        },
        {
          "info": {
            "name": "Detail Carnet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/carnet/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Detail Carnet"
        },
        {
