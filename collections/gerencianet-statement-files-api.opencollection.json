{
  "opencollection": "1.0.0",
  "info": {
    "name": "Efí Pay Cobranças Account Statement Files API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://cobrancas.api.efipay.com.br/v1/authorize",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Statement Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Statement Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/extrato-cnab/arquivos"
          },
          "docs": "List Statement Files"
        },
        {
          "info": {
            "name": "Download Statement File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cobrancas.api.efipay.com.br/v1/extrato-cnab/download/:nome_arquivo",
            "params": [
              {
                "name": "nome_arquivo",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download Statement File"
        }
      ]
    }
  ],
  "bundled": true
}